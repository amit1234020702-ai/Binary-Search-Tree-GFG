class Node {
    int data;
    Node left, right;

    Node(int data) {
        this.data = data;
    }
}

public class FloorInBST {

    public static int findMaxFork(Node root, int k) {
        int ans = -1;

        while (root != null) {

            if (root.data == k) {
                return root.data;
            } else if (root.data < k) {
                ans = root.data;
                root = root.right;
            } else {
                root = root.left;
            }
        }

        return ans;
    }

    public static void main(String[] args) {

        Node a = new Node(10);
        Node b = new Node(7);
        Node c = new Node(15);
        Node d = new Node(2);
        Node e = new Node(8);
        Node f = new Node(11);
        Node g = new Node(16);

        // Connect Nodes
        a.left = b;
        a.right = c;

        b.left = d;
        b.right = e;

        c.left = f;
        c.right = g;

        int k = 14;

        System.out.println(findMaxFork(a, k));
    }
}
